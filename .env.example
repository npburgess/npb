# EmailJS credentials for the contact form (client-side / public by design).
# Astro exposes only PUBLIC_-prefixed vars to client code, so these MUST use PUBLIC_.
# Copy to .env and fill in. For the GitHub Actions build, set these as repo secrets.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
