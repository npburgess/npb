---
// Contact form dialog — native <dialog> + EmailJS, no framework.
// Native <dialog> gives role=dialog, aria-modal, focus-trap and Escape-to-close;
// the script adds focus-return to the trigger. Opens from any [data-contact] element.
---

<dialog class="contact-dialog" id="contact-dialog" aria-labelledby="cd-title">
	<form id="contact-form">
		<div class="cd-head">
			<h3 id="cd-title">Say g'day</h3>
			<button type="button" class="cd-x" data-cd-close aria-label="Close">✕</button>
		</div>
		<label class="cd-field">
			Name
			<input id="cd-name" name="name" type="text" required />
		</label>
		<label class="cd-field">
			Email
			<input id="cd-email" name="email" type="email" required />
		</label>
		<label class="cd-field">
			Message
			<textarea id="cd-message" name="message" rows="4" required></textarea>
		</label>
		<p class="cd-status" id="cd-status" hidden></p>
		<div class="cd-actions">
			<button type="submit" class="btn btn-solid cd-send">Send</button>
			<button type="button" class="btn btn-ghost" data-cd-close>Cancel</button>
		</div>
	</form>
</dialog>

<style>
	.contact-dialog {
		width: calc(100% - 40px);
		max-width: 520px;
		margin: auto;
		padding: 0;
		background: var(--bg);
		border: 1px solid var(--hair);
		color: var(--fg);
	}
	.contact-dialog::backdrop {
		background: oklch(0 0 0 / 0.45);
	}
	.contact-dialog form {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: clamp(24px, 4vw, 40px);
	}
	.cd-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 10px;
	}
	.cd-head h3 {
		margin: 0;
		font-size: 28px;
		font-weight: 500;
		letter-spacing: -0.03em;
	}
	.cd-x {
		background: transparent;
		border: 0;
		color: var(--muted);
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1;
	}
	.cd-x:hover {
		color: var(--accent);
	}
	.cd-field {
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.contact-dialog input,
	.contact-dialog textarea {
		width: 100%;
		font-family: var(--font-sans);
		font-size: 15px;
		letter-spacing: 0;
		text-transform: none;
		color: var(--fg);
		background: transparent;
		border: 1px solid var(--hair);
		padding: 11px 12px;
	}
	.contact-dialog textarea {
		resize: vertical;
	}
	.contact-dialog input:focus,
	.contact-dialog textarea:focus {
		outline: none;
		border-color: var(--accent);
	}
	.cd-status {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.04em;
	}
	.cd-status.ok {
		color: var(--accent);
	}
	.cd-status.err {
		color: var(--accent);
	}
	.cd-actions {
		display: flex;
		gap: 10px;
		margin-top: 6px;
	}
	.cd-send {
		flex: 1;
		justify-content: center;
	}
</style>

<script>
	import emailjs from "@emailjs/browser";

	const dialog = document.getElementById("contact-dialog") as HTMLDialogElement | null;
	if (dialog) {
		const form = document.getElementById("contact-form") as HTMLFormElement;
		const statusEl = document.getElementById("cd-status") as HTMLParagraphElement;
		let lastTrigger: HTMLElement | null = null;

		const setStatus = (msg: string, isError = false) => {
			statusEl.textContent = msg;
			statusEl.hidden = false;
			statusEl.className = "cd-status " + (isError ? "err" : "ok");
		};
		const close = () => {
			dialog.close();
		};

		document.querySelectorAll<HTMLElement>("[data-contact]").forEach((t) =>
			t.addEventListener("click", (e) => {
				e.preventDefault();
				lastTrigger = t;
				statusEl.hidden = true;
				statusEl.textContent = "";
				dialog.showModal();
			})
		);
		dialog.querySelectorAll<HTMLElement>("[data-cd-close]").forEach((b) => b.addEventListener("click", close));
		// backdrop click closes
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) close();
		});
		// return focus to the trigger when the dialog closes (Escape or button)
		dialog.addEventListener("close", () => lastTrigger?.focus());

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			setStatus("Sending…");
			const fd = new FormData(form);
			const params = {
				name: String(fd.get("name") ?? ""),
				email: String(fd.get("email") ?? ""),
				message: String(fd.get("message") ?? "")
			};
			try {
				await emailjs.send(
					import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
					import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID,
					params,
					import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY
				);
				setStatus("Message sent. Thanks, I'll be in touch.");
				form.reset();
			} catch (err) {
				const x = err as { status?: number; text?: string };
				console.error("EmailJS send failed:", x?.status, x?.text ?? err);
				setStatus("Something went wrong. Please try again later.", true);
			}
		});
	}
</script>
