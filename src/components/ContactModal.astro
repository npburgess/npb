---
// Contact form dialog — native <dialog> + EmailJS, no framework.
// Opens from any element with a [data-contact] attribute.
---

<dialog class="contact-dialog" id="contact-dialog">
	<form id="contact-form">
		<div class="cd-head">
			<h3 class="disp">Say g'day</h3>
			<button type="button" class="cd-x" data-cd-close aria-label="Close">×</button>
		</div>
		<label class="sr-only" for="cd-name">Name</label>
		<input id="cd-name" name="name" type="text" placeholder="Name" required />
		<label class="sr-only" for="cd-email">Email</label>
		<input id="cd-email" name="email" type="email" placeholder="Email" required />
		<label class="sr-only" for="cd-message">Message</label>
		<textarea id="cd-message" name="message" placeholder="Message" rows="4" required></textarea>
		<p class="cd-status" id="cd-status" hidden></p>
		<div class="cd-actions">
			<button type="button" class="cd-cancel" data-cd-close>Cancel</button>
			<button type="submit" class="cd-send">Send</button>
		</div>
	</form>
</dialog>

<style>
	.contact-dialog {
		width: calc(100% - 32px);
		max-width: 460px;
		margin: auto;
		border: 1px solid #cdd5cf;
		border-radius: 10px;
		padding: 0;
		background: var(--paper);
		color: var(--ink);
	}
	.contact-dialog::backdrop {
		background: rgba(27, 42, 39, 0.4);
		backdrop-filter: blur(2px);
	}
	.contact-dialog form {
		padding: 26px;
	}
	.cd-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}
	.cd-head h3 {
		font-family: "Space Grotesk", sans-serif;
		font-size: 24px;
		font-weight: 500;
		margin: 0;
	}
	.cd-x {
		border: 0;
		background: none;
		font-size: 24px;
		line-height: 1;
		cursor: pointer;
		color: var(--sub);
	}
	.cd-x:hover {
		color: var(--survey-text);
	}
	.contact-dialog input,
	.contact-dialog textarea {
		width: 100%;
		font-family: "Inter", sans-serif;
		font-size: 14px;
		color: var(--ink);
		background: #fff;
		border: 1px solid #cdd5cf;
		border-radius: 6px;
		padding: 10px 12px;
		margin-bottom: 10px;
	}
	.contact-dialog input:focus,
	.contact-dialog textarea:focus {
		outline: 2px solid var(--survey);
		outline-offset: 1px;
		border-color: var(--survey);
	}
	.cd-status {
		font-size: 13px;
		margin: 2px 0 10px;
	}
	.cd-status.ok {
		color: var(--teal);
	}
	.cd-status.err {
		color: #b3402a;
	}
	.cd-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 6px;
	}
	.cd-actions button {
		font-family: "IBM Plex Mono", monospace;
		font-size: 13px;
		padding: 9px 18px;
		border-radius: 6px;
		cursor: pointer;
	}
	.cd-cancel {
		background: transparent;
		border: 1px solid #cdd5cf;
		color: var(--ink);
	}
	.cd-cancel:hover {
		border-color: var(--ink);
	}
	.cd-send {
		background: var(--survey-text);
		border: 0;
		color: #fff;
	}
	.cd-send:hover {
		background: var(--teal);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
</style>

<script>
	import emailjs from "@emailjs/browser";

	const dialog = document.getElementById("contact-dialog") as HTMLDialogElement | null;
	if (dialog) {
		const form = document.getElementById("contact-form") as HTMLFormElement;
		const statusEl = document.getElementById("cd-status") as HTMLParagraphElement;

		const setStatus = (msg: string, isError = false) => {
			statusEl.textContent = msg;
			statusEl.hidden = false;
			statusEl.className = "cd-status " + (isError ? "err" : "ok");
		};
		const close = () => {
			dialog.close();
			statusEl.hidden = true;
			statusEl.textContent = "";
		};

		document
			.querySelectorAll<HTMLElement>("[data-contact]")
			.forEach((t) => t.addEventListener("click", (e) => {
				e.preventDefault();
				dialog.showModal();
			}));
		dialog.querySelectorAll<HTMLElement>("[data-cd-close]").forEach((b) => b.addEventListener("click", close));
		// backdrop click closes
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) close();
		});

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			setStatus("Sending…");
			const fd = new FormData(form);
			const params = {
				name: String(fd.get("name") ?? ""),
				email: String(fd.get("email") ?? ""),
				message: String(fd.get("message") ?? "")
			};
			try {
				await emailjs.send(
					import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
					import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID,
					params,
					import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY
				);
				setStatus("Message sent — thanks, I'll be in touch.");
				form.reset();
			} catch (err) {
				const x = err as { status?: number; text?: string };
				console.error("EmailJS send failed:", x?.status, x?.text ?? err);
				setStatus("Something went wrong. Please try again later.", true);
			}
		});
	}
</script>
