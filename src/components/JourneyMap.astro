<style>
	.map {
		margin: 20px 0 8px;
		overflow: hidden;
	}
	.map svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.map :global(.land) {
		fill: #dfe4de;
		stroke: #9aac9f;
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.map :global(.route) {
		fill: none;
		stroke: var(--teal);
		stroke-width: 2;
		stroke-dasharray: 6 6;
		stroke-linecap: round;
	}
	.map :global(.route.arc) {
		stroke: var(--survey);
	}
	.map :global(.wp) {
		fill: var(--paper);
		stroke: var(--teal);
		stroke-width: 2.5;
	}
	.map :global(.wp.big) {
		stroke: var(--survey);
	}
	.map :global(.name) {
		font-family: "IBM Plex Mono", monospace;
		font-size: 12px;
		font-weight: 500;
		fill: var(--ink);
	}
	.map :global(.region) {
		font-family: "Space Grotesk", sans-serif;
		letter-spacing: 0.28em;
		fill: #8fa295;
		opacity: 0.7;
		text-anchor: middle;
	}
	@media (prefers-reduced-motion: no-preference) {
		.map :global(.route) {
			stroke-dashoffset: 900;
			animation: map-draw 3.5s ease forwards;
		}
		.map :global(.route.a2) {
			animation-delay: 0.5s;
		}
		.map :global(.route.a3) {
			animation-delay: 1.4s;
		}
		@keyframes map-draw {
			to {
				stroke-dashoffset: 0;
			}
		}
	}
</style>
