---
const links = [
	{ href: "/", label: "Home" },
	{ href: "/#about", label: "About" },
	{ href: "/projects", label: "Projects" }
];
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-gray-100/80 backdrop-blur">
	<nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
		<a href="/" class="font-bold tracking-tight">npb.me</a>
		<ul class="flex items-center gap-6 text-sm text-slate-600">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-blue-600">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
