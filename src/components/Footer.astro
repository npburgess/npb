---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<span class="left">© {year} Nathaniel Burgess</span>
		<span class="mid">
			<a
				href="https://abr.business.gov.au/ABN/View?abn=19770939577"
				target="_blank"
				rel="noopener noreferrer">ABN 19 770 939 577</a>
		</span>
		<span class="right">Launceston · Tasmania</span>
	</div>
</footer>

<style>
	.site-footer {
		padding: 0 clamp(18px, 3.5vw, 40px);
	}
	.inner {
		align-items: center;
		border-top: 1px solid var(--line);
		color: var(--muted);
		display: grid;
		font-family: var(--font-mono);
		font-size: 10px;
		gap: 12px;
		grid-template-columns: 1fr auto 1fr;
		letter-spacing: 0.14em;
		padding: 16px 0 28px;
		text-transform: uppercase;
	}
	.left {
		text-align: left;
	}
	.mid {
		text-align: center;
	}
	.right {
		text-align: right;
	}
	.mid a {
		color: inherit;
		text-decoration: none;
	}
	.mid a:hover {
		color: var(--accent);
	}
	@media (max-width: 560px) {
		.inner {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.left,
		.right {
			text-align: center;
		}
	}
</style>
