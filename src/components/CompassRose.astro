---
// Slowly-rotating compass rose used in the hero. Tucks away (opacity 0) once the
// page scrolls, handled by BackToTop which toggles `.tucked` on `.rose`.
---

<div class="rose" aria-hidden="true">
	<svg viewBox="0 0 100 100">
		<circle cx="50" cy="50" r="46" fill="none" stroke="#0f3d3e" stroke-width="1" />
		<circle cx="50" cy="50" r="34" fill="none" stroke="#c7d0ca" stroke-width="1" />
		<path d="M50 6 L56 50 L50 94 L44 50 Z" fill="#e2622f" />
		<path d="M6 50 L50 44 L94 50 L50 56 Z" fill="#1b2a27" />
		<text x="50" y="19" text-anchor="middle" font-size="8" font-family="IBM Plex Mono" fill="#1b2a27">N</text>
	</svg>
</div>

<style>
	.rose {
		width: 116px;
		height: 116px;
		transition: opacity 0.35s;
	}
	.rose.tucked {
		opacity: 0;
	}
	.rose svg {
		width: 100%;
		height: 100%;
	}
	@media (prefers-reduced-motion: no-preference) {
		.rose svg {
			animation: rose-spin 44s linear infinite;
		}
	}
	@keyframes rose-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (max-width: 680px) {
		.rose {
			display: none;
		}
	}
</style>
