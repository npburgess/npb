---
// Self-hosted mono (same-origin; removes render-blocking Google Fonts requests).
// Display/UI uses the Helvetica Neue system stack — no webfont to load.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
	title?: string;
	seoTitle?: string;
	description?: string;
	image?: string;
}

const {
	title = "Nathaniel Burgess | npb.me",
	seoTitle,
	description = "The personal website of Nathaniel Burgess, a Software Engineer living in Launceston, Tasmania.",
	image = "/og.png"
} = Astro.props;

// <title> can run longer for SEO/SERP; og:title stays short and clean for social cards.
const pageTitle = seoTitle ?? title;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const isArticle = Astro.url.pathname.startsWith("/projects/") && Astro.url.pathname !== "/projects/";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Nathaniel Burgess",
	url: "https://npb.me",
	jobTitle: "Software Engineer",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Launceston",
		addressRegion: "Tasmania",
		addressCountry: "AU"
	},
	sameAs: [
		"https://github.com/npburgess",
		"https://www.linkedin.com/pub/nathaniel-burgess/30/942/b69"
	]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta name="author" content="Nathaniel Burgess" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1f1e1b" media="(prefers-color-scheme: dark)" />
		<link rel="canonical" href={canonical} />

		{/* Anti-flash: set data-theme before first paint. Mode persists to
		   localStorage; auto resolves via OS preference. try/catch — private mode throws. */}
		<script is:inline>
			(function () {
				try {
					var mode = localStorage.getItem("npb-theme") || "auto";
					var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var t = mode === "auto" ? (dark ? "dark" : "light") : mode;
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {
					document.documentElement.setAttribute("data-theme", "light");
				}
			})();
		</script>

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:type" content={isArticle ? "article" : "website"} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="npb.me" />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Nathaniel Burgess, npb.me" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Nathaniel Burgess, npb.me" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

		<title>{pageTitle}</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		<BackToTop />
		{
			/* Cloudflare Web Analytics (cookieless). Public beacon token; prod-only so it
			   never counts local dev traffic. */
			import.meta.env.PROD && (
				<script
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon='{"token": "e7a734aa00ef4cf980d95ee7126e0aa3"}'
				/>
			)
		}
	</body>
</html>
