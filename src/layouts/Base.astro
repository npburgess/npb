---
import "../styles/global.css";
import ContourField from "../components/ContourField.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
	title?: string;
	seoTitle?: string;
	description?: string;
	image?: string;
}

const {
	title = "Nathaniel Burgess | npb.me",
	seoTitle,
	description = "The personal website of Nathaniel Burgess, a Software Engineer living in Launceston, Tasmania.",
	image = "/og.png"
} = Astro.props;

// <title> can run longer for SEO/SERP; og:title stays short and clean for social cards.
const pageTitle = seoTitle ?? title;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const isArticle = Astro.url.pathname.startsWith("/projects/") && Astro.url.pathname !== "/projects/";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Nathaniel Burgess",
	url: "https://npb.me",
	jobTitle: "Software Engineer",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Launceston",
		addressRegion: "Tasmania",
		addressCountry: "AU"
	},
	sameAs: [
		"https://github.com/npburgess",
		"https://www.linkedin.com/pub/nathaniel-burgess/30/942/b69"
	]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta name="author" content="Nathaniel Burgess" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#eaece9" />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:type" content={isArticle ? "article" : "website"} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="npb.me" />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Nathaniel Burgess — npb.me" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Nathaniel Burgess — npb.me" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<ContourField />
		<div class="frame">
			<div class="wrap">
				<Nav />
				<slot />
				<Footer />
			</div>
		</div>
		<BackToTop />
	</body>
</html>
