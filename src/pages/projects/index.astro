---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const order = ["thusword", "keirons-krafts", "compass", "boozers"];
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => order.indexOf(a.id) - order.indexOf(b.id)
);
const displayUrl = (u?: string) => (u ? u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "") : "");
---

<Base title="Projects | npb.me" description="Projects built by Nathaniel Burgess.">
	<div class="shead projects-top"><span class="idx mono">◈</span><h2 class="mono">ALL PROJECTS</h2><span class="rule"></span></div>
	<div class="stops">
		{
			projects.map((p, i) => (
				<div class={`stop${p.data.featured ? " feat" : ""}`}>
					<div>
						<div class="n mono">
							{String(i + 1).padStart(2, "0")}
							{p.data.featured ? " · FEATURED" : ""}
						</div>
						<h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
						<div class="d">{p.data.summary}</div>
					</div>
					<div class="meta">
						<span class={`tag${p.data.type === "work" ? " work" : ""}`}>{p.data.type}</span>
						<div class="coord mono">{displayUrl(p.data.liveUrl)}</div>
						<a class="go mono" href={`/projects/${p.id}`} aria-label={`Read about ${p.data.title}`}>read →</a>
					</div>
				</div>
			))
		}
	</div>
</Base>

<style>
	.projects-top {
		padding-top: 70px;
	}
</style>
