---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

// Paid work first, then hobby — matches the home page order.
const order = ["compass", "global-operation-centre", "thusword", "keirons-krafts", "bespoke-betty", "boozers"];
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => order.indexOf(a.id) - order.indexOf(b.id)
);
---

<Base title="Projects | npb.me" description="Projects built by Nathaniel Burgess.">
	<section class="section railed projects">
		<div class="rail"><span class="num">—</span><br /><span class="lbl">WORK</span></div>
		<div class="rail-body">
			<h1 class="projects-h1">All projects.</h1>
			<div class="worktable">
				<div class="workrow head">
					<span>Project</span><span>Description</span><span>Type</span><span class="r">Link</span>
				</div>
				{
					projects.map((p) => (
						<a class="workrow" href={`/projects/${p.id}`} aria-label={p.data.title}>
							<span class="name">{p.data.title}</span>
							<span class="desc">{p.data.summary}</span>
							<span class={`type-tag ${p.data.type}`}>{p.data.type}</span>
							<span class="link">Case ↗</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Base>

<style>
	.rail-body {
		padding: 52px 0;
	}
	.projects-h1 {
		margin: 0 0 34px;
		font-size: clamp(40px, 6vw, 72px);
		line-height: 0.94;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
</style>
