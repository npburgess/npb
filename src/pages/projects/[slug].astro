---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project }
	}));
}

const { project } = Astro.props;
const { title, summary, type, tech, liveUrl, repoUrl } = project.data;
const { Content } = await render(project);
const displayUrl = (u?: string) => (u ? u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "") : "");
---

<Base title={`${title} | npb.me`} description={summary}>
	<section class="section case-section">
		<article class="case">
			<a class="back label" href="/projects">← All projects</a>

			<div class="case-head">
				<h1 class="case-h1">{title}</h1>
				<span class={`type-tag ${type}`}>{type}</span>
			</div>
			<p class="lede">{summary}</p>

			{
				tech.length > 0 && (
					<ul class="tech">
						{tech.map((t) => (
							<li class="chip">{t}</li>
						))}
					</ul>
				)
			}

			<div class="links">
				{
					liveUrl && (
						<a class="btn btn-ghost" href={liveUrl} target="_blank" rel="noopener noreferrer">
							{displayUrl(liveUrl)} ↗
						</a>
					)
				}
				{
					repoUrl && (
						<a class="btn btn-ghost" href={repoUrl} target="_blank" rel="noopener noreferrer">
							Source ↗
						</a>
					)
				}
			</div>

			<div class="body">
				<Content />
			</div>
		</article>
	</section>
</Base>

<style>
	.case-section {
		border-bottom: 0;
	}
	.case {
		max-width: 46rem;
		padding: 52px 0;
	}
	.back {
		display: inline-block;
	}
	.back:hover {
		color: var(--accent);
	}
	.case-head {
		display: flex;
		align-items: baseline;
		gap: 14px;
		margin: 24px 0 8px;
	}
	.case-h1 {
		margin: 0;
		font-size: clamp(34px, 6vw, 60px);
		line-height: 0.95;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.lede {
		margin: 0 0 22px;
		color: var(--body);
		font-size: 18px;
		line-height: 1.55;
		max-width: 52ch;
	}
	.tech {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 0;
		margin: 0 0 22px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 40px;
	}

	/* case-study body */
	.body {
		border-top: 1px solid var(--line);
		padding-top: 30px;
		color: var(--body);
		font-size: 16px;
		line-height: 1.7;
		max-width: 46ch;
	}
	.body :global(h2) {
		font-size: clamp(22px, 3vw, 28px);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--fg);
		margin: 34px 0 12px;
	}
	.body :global(p) {
		margin: 0 0 16px;
	}
	.body :global(ul) {
		margin: 0 0 16px;
		padding-left: 20px;
	}
	.body :global(li) {
		margin: 4px 0;
	}
	.body :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.body :global(strong) {
		color: var(--fg);
	}
	.body :global(blockquote) {
		border-left: 2px solid var(--accent);
		margin: 20px 0;
		padding: 4px 0 4px 16px;
		color: var(--muted);
	}
	.body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--panel);
		border: 1px solid var(--line-soft);
		padding: 1px 5px;
	}
</style>
