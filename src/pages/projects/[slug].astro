---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project }
	}));
}

const { project } = Astro.props;
const { title, summary, type, tech, liveUrl, repoUrl, cover } = project.data;
const { Content } = await render(project);
const displayUrl = (u?: string) => (u ? u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "") : "");
---

<Base title={`${title} | npb.me`} description={summary}>
	<section class="section case-section">
		<div class:list={["case-grid", { "has-preview": cover }]}>
			<article class="case">
				<a class="back label" href="/projects">← All projects</a>

				<div class="case-head">
					<h1 class="case-h1">{title}</h1>
					<span class={`type-tag ${type}`}>{type}</span>
				</div>
				<p class="lede">{summary}</p>

				{
					tech.length > 0 && (
						<ul class="tech">
							{tech.map((t) => (
								<li class="chip">{t}</li>
							))}
						</ul>
					)
				}

				<div class="links">
					{
						liveUrl && (
							<a class="btn btn-ghost" href={liveUrl} target="_blank" rel="noopener noreferrer">
								{displayUrl(liveUrl)} ↗
							</a>
						)
					}
					{
						repoUrl && (
							<a class="btn btn-ghost" href={repoUrl} target="_blank" rel="noopener noreferrer">
								Source ↗
							</a>
						)
					}
				</div>

				<div class="body">
					<Content />
				</div>
			</article>

			{
				cover && (
					<aside class="preview">
						<div class="preview-panel">
							<span class="preview-label label">Preview</span>
							<a
								class="preview-shot"
								href={liveUrl ?? "#"}
								target={liveUrl ? "_blank" : undefined}
								rel={liveUrl ? "noopener noreferrer" : undefined}
							>
								<Image src={cover} alt={`Screenshot of ${title}`} widths={[420, 840]} sizes="(max-width: 900px) 100vw, 420px" />
							</a>
							{liveUrl && (
								<a class="preview-visit label" href={liveUrl} target="_blank" rel="noopener noreferrer">
									Visit {displayUrl(liveUrl)} ↗
								</a>
							)}
						</div>
					</aside>
				)
			}
		</div>
	</section>
</Base>

<style>
	.case-section {
		border-bottom: 0;
	}
	.case-grid {
		display: block;
	}
	.case {
		max-width: 46rem;
		padding: 52px 0;
	}

	/* two-column with sticky preview rail (only when a cover exists) */
	@media (min-width: 900px) {
		.case-grid.has-preview {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 380px;
			gap: clamp(32px, 5vw, 72px);
			align-items: start;
		}
	}

	.preview {
		padding: 52px 0;
	}
	.preview-panel {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.preview-label {
		color: var(--muted);
	}
	.preview-shot {
		display: block;
		border: 1px solid var(--line);
		overflow: hidden;
	}
	.preview-shot :global(img) {
		aspect-ratio: 3 / 2;
		display: block;
		height: auto;
		object-fit: cover;
		object-position: center top;
		width: 100%;
	}
	.preview-visit:hover {
		color: var(--accent);
	}

	@media (min-width: 900px) {
		.preview {
			position: sticky;
			top: 96px;
		}
	}

	/* mobile: stack, with the preview lifted above the article */
	@media (max-width: 899px) {
		.case-grid.has-preview {
			display: flex;
			flex-direction: column;
		}
		.case-grid.has-preview .preview {
			order: -1;
			padding: 44px 0 0;
		}
		.case-grid.has-preview .case {
			padding-top: 28px;
		}
		.preview-panel {
			max-width: 46rem;
		}
	}
	.back {
		display: inline-block;
	}
	.back:hover {
		color: var(--accent);
	}
	.case-head {
		display: flex;
		align-items: baseline;
		gap: 14px;
		margin: 24px 0 8px;
	}
	.case-h1 {
		margin: 0;
		font-size: clamp(34px, 6vw, 60px);
		line-height: 0.95;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.lede {
		margin: 0 0 22px;
		color: var(--body);
		font-size: 18px;
		line-height: 1.55;
		max-width: 52ch;
	}
	.tech {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 0;
		margin: 0 0 22px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 40px;
	}

	/* case-study body */
	.body {
		border-top: 1px solid var(--line);
		padding-top: 30px;
		color: var(--body);
		font-size: 16px;
		line-height: 1.7;
		max-width: 46ch;
	}
	.body :global(h2) {
		font-size: clamp(22px, 3vw, 28px);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--fg);
		margin: 34px 0 12px;
	}
	.body :global(p) {
		margin: 0 0 16px;
	}
	.body :global(ul) {
		margin: 0 0 16px;
		padding-left: 20px;
	}
	.body :global(li) {
		margin: 4px 0;
	}
	.body :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.body :global(strong) {
		color: var(--fg);
	}
	.body :global(blockquote) {
		border-left: 2px solid var(--accent);
		margin: 20px 0;
		padding: 4px 0 4px 16px;
		color: var(--muted);
	}
	.body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--panel);
		border: 1px solid var(--line-soft);
		padding: 1px 5px;
	}
</style>
