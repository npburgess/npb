---
import Base from "../layouts/Base.astro";
import CompassRose from "../components/CompassRose.astro";
---

<Base title="404 — Off the map | npb.me" description="This page isn't on the map.">
	<section class="notfound">
		<CompassRose />
		<span class="coord mono">ERROR · 404 · NO FIX</span>
		<h1 class="disp">Off the map.</h1>
		<p>This page isn't on the map — it may have moved, or it never existed.</p>
		<div class="links mono">
			<a href="/">← Back to the start</a>
			<a href="/projects">View projects</a>
		</div>
	</section>
</Base>

<style>
	.notfound {
		min-height: 62vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 6px;
		padding: 60px 0;
	}
	.notfound .coord {
		font-size: 12px;
		letter-spacing: 0.14em;
		color: var(--survey);
		margin-top: 18px;
	}
	.notfound h1 {
		font-family: "Space Grotesk", sans-serif;
		font-size: clamp(40px, 8vw, 72px);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 6px 0 10px;
	}
	.notfound p {
		color: var(--sub);
		font-size: 17px;
		max-width: 42ch;
		margin: 0 0 26px;
	}
	.notfound .links {
		display: flex;
		gap: 22px;
		font-size: 14px;
	}
	.notfound .links a {
		color: var(--teal);
		text-decoration: none;
	}
	.notfound .links a:hover {
		color: var(--survey);
	}
</style>
