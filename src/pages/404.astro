---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Not found | npb.me" description="This page could not be found.">
	<section class="section notfound">
		<span class="eyebrow">Error · 404</span>
		<h1 class="nf-h1">Not found.</h1>
		<p class="nf-p">This page may have moved, or it never existed.</p>
		<div class="nf-links">
			<a class="btn btn-solid" href="/">← Home</a>
			<a class="btn btn-ghost" href="/projects">View projects</a>
		</div>
	</section>
</Base>

<style>
	.notfound {
		border-bottom: 0;
		min-height: 62vh;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 16px;
		padding-top: 60px;
		padding-bottom: 60px;
	}
	.nf-h1 {
		margin: 0;
		font-size: clamp(44px, 9vw, 96px);
		line-height: 0.9;
		letter-spacing: -0.045em;
		font-weight: 500;
	}
	.nf-p {
		margin: 0;
		color: var(--body);
		font-size: 17px;
		max-width: 42ch;
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 10px;
	}
</style>
