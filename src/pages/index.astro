---
import Base from "../layouts/Base.astro";
import profileImg from "../../public/profile_sm.jpg";
---

<Base>
	<main class="mx-auto max-w-2xl px-6 py-16">
		<section class="flex flex-col items-center text-center">
			<img
				src={profileImg.src}
				alt="Nathaniel Burgess"
				width="160"
				height="160"
				class="h-40 w-40 rounded-full border border-gray-200"
			/>
			<h1 class="mt-6 text-3xl font-bold">Nathaniel Burgess</h1>
			<p class="mt-2 text-slate-500">Software Engineer living in Launceston, Tasmania.</p>
			<p class="mt-1 text-slate-500">I love tech, a local brew, and travelling with my family.</p>
			<a
				href="/projects"
				class="mt-6 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-500"
			>
				See my projects
			</a>
		</section>

		<section id="about" class="mt-16 scroll-mt-20">
			<h2 class="text-xl font-bold">About</h2>
			<p class="mt-3 text-slate-600">
				Placeholder about section — real copy and layout come after the mockup stage.
			</p>
		</section>
	</main>
</Base>
