---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ContactModal from "../components/ContactModal.astro";
import portrait from "../assets/portrait.png";

// Path — biographical waypoints (systematic redesign; inline, no map).
const path = [
	{ kicker: "1985", title: "North-west coast", desc: "Born and raised on the North West Coast of Tasmania, the city by the sea." },
	{ kicker: "Hobart · UTAS", title: "Computer science", desc: "Moved south to study. Turned an aptitude into a career." },
	{ kicker: "12 years", title: "Los Angeles", desc: "A hemisphere from home. Got married, rescued a dog and had three kids along the way." },
	{ kicker: "Now · 3 yrs", title: "Launceston", desc: "Brought everyone home. Bikes to school, the garden, the squash court. A balance that made the move worth it.", now: true }
];

// Work — paid work first, then hobby. Descriptions tuned for the table rhythm.
const work = [
	{ name: "Cycle Inspect", desc: "A bike-inspection platform for field inspections, dashboards and PDF reports.", type: "work", href: "/projects/compass" },
	{ name: "Global Operation Centre", desc: "Data visualisation for on-call engineers and field technicians at Firmus.", type: "work", href: "/projects/global-operation-centre" },
	{ name: "Thusword", desc: "A once-a-day word game, a freeform crossword solved by progressive reveal.", type: "hobby", href: "/projects/thusword" },
	{ name: "Keiron's Krafts", desc: "An online storefront for handmade goods, with invoicing and image uploads.", type: "hobby", href: "/projects/keirons-krafts" },
	{ name: "Bespoke Betty", desc: "A showcase site for made-to-order clothing. Client-editable, no backend to run.", type: "hobby", href: "/projects/bespoke-betty" },
	{ name: "Boozers Squash", desc: "A single-page marketing site for a Launceston squash club.", type: "hobby", href: "/projects/boozers" }
];

const stack = ["Typescript", "React", "Astro", "Python", "Postgres", "A11y", "Claude Code"];
---

<Base seoTitle="Nathaniel Burgess | Software Engineer, Launceston Tasmania">
	{/* ---- HERO ---- */}
	<section id="top" class="section hero">
		<div class="hero-grid">
			<div class="hero-head">
				<div class="eyebrow hero-eyebrow">
					<span>Software engineer</span><span class="slash">/</span><span>Launceston, Tasmania</span>
				</div>
				<h1 class="hero-h1">Nathaniel<br />Burgess</h1>
			</div>

			<div class="hero-lede">
				<p>
					Sixteen years building software, twelve of them in Los Angeles, the rest back home on
					the island I grew up on. Modern TypeScript stack, plain-language explanations, work that
					stays maintainable.
				</p>
				<div class="hero-cta">
					<a class="btn btn-solid" href="#work">View work ↓</a>
					<a class="btn btn-ghost" href="#contact" data-contact>Say g'day</a>
				</div>
			</div>

			<div class="hero-spec">
				<dl class="spec">
					<div><dt>Exp</dt><dd>16 yrs</dd></div>
					<div><dt>Current</dt><dd>Cycle Inspect</dd></div>
					<div><dt>Stack</dt><dd>TS / PY</dd></div>
					<div><dt>Mode</dt><dd>Hybrid</dd></div>
					<div><dt>Base</dt><dd>Launceston</dd></div>
				</dl>
			</div>

			<div class="hero-portrait">
				<Image
					src={portrait}
					width={900}
					height={833}
					format="webp"
					alt="Nathaniel Burgess"
					loading="eager"
					decoding="async"
				/>
			</div>
		</div>
	</section>

	{/* ---- 01 PATH ---- */}
	<section id="path" class="section railed">
		<div class="rail"><span class="num">01</span><br /><span class="lbl">PATH</span></div>
		<div class="rail-body">
			<div class="path-grid">
				{
					path.map((p) => (
						<div class={`path-cell${p.now ? " now" : ""}`}>
							<div class={`label path-kicker${p.now ? " accent" : ""}`}>{p.kicker}</div>
							<div class="path-title">{p.title}</div>
							<p class="path-desc">{p.desc}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	{/* ---- 02 METHOD ---- */}
	<section id="method" class="section railed">
		<div class="rail"><span class="num">02</span><br /><span class="lbl">METHOD</span></div>
		<div class="rail-body method-body">
			<div class="method-grid">
				<div>
					<h2 class="method-h2">People first, then the code.</h2>
					<p class="method-p">
						I like being in the office a few days a week: a whiteboard, a coffee, the team in one
						room. The best software comes from people who actually talk to each other, so I keep the
						technical part in plain terms and make sure everyone understands the journey, not just the
						engineers.
					</p>
				</div>
				<div>
					<h2 class="method-h2">Tested, accessible, fast.</h2>
					<p class="method-p">
						A modern TypeScript stack with Python behind it. AI tooling is part of the day-to-day
						without losing the plot. I care about work that stays maintainable and a pace that stays
						sustainable.
					</p>
					<div class="chips">
						{stack.map((t) => <span class="chip">{t}</span>)}
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* ---- 03 WORK ---- */}
	<section id="work" class="section railed">
		<div class="rail"><span class="num">03</span><br /><span class="lbl">WORK</span></div>
		<div class="rail-body work-body">
			<div class="worktable">
				<div class="workrow head">
					<span>Project</span><span>Description</span><span>Type</span><span class="r">Link</span>
				</div>
				{
					work.map((w) => (
						<a class="workrow" href={w.href} aria-label={w.name}>
							<span class="name">{w.name}</span>
							<span class="desc">{w.desc}</span>
							<span class={`type-tag ${w.type}`}>{w.type}</span>
							<span class="link">Case ↗</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	{/* ---- 04 CONTACT ---- */}
	<section id="contact" class="section railed">
		<div class="rail"><span class="num">04</span><br /><span class="lbl">CONTACT</span></div>
		<div class="rail-body contact-body">
			<h2 class="contact-h2">Get in touch.</h2>
			<p class="contact-p">
				Hiring, working on something, or just want to say hello, drop me a line.
			</p>
			<div class="contact-actions">
				<button type="button" class="btn btn-solid" data-contact>Say g'day ↗</button>
				<a class="btn btn-ghost" href="https://github.com/npburgess" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
				<a class="btn btn-ghost" href="https://www.linkedin.com/pub/nathaniel-burgess/30/942/b69" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
			</div>
		</div>
	</section>

	<ContactModal />
</Base>

<style>
	/* ---- hero ---- */
	.hero-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
	}
	.hero-head {
		grid-column: 1 / span 12;
		/* symmetric top/bottom; the extra bottom room lets the H1 "g" descender
		   clear the divider rule despite line-height: 0.85 */
		padding: clamp(48px, 6vw, 84px) 0 clamp(48px, 6vw, 84px);
	}
	.hero-eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		margin-bottom: clamp(24px, 4vw, 40px);
	}
	.hero-eyebrow .slash {
		color: var(--muted);
	}
	.hero-h1 {
		margin: 0;
		font-size: clamp(52px, 11.5vw, 168px);
		line-height: 0.85;
		letter-spacing: -0.045em;
		font-weight: 500;
		text-wrap: balance;
	}
	.hero-lede {
		grid-column: 1 / span 5;
		padding: 30px 40px 56px 0;
		border-top: 1px solid var(--line);
	}
	.hero-lede p {
		margin: 0;
		font-size: clamp(17px, 1.5vw, 20px);
		line-height: 1.5;
		max-width: 36ch;
		text-wrap: pretty;
	}
	.hero-cta {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		margin-top: 32px;
	}
	.hero-spec {
		grid-column: 6 / span 3;
		padding: 30px 24px 56px 0;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line-soft);
	}
	.spec {
		margin: 0;
		padding-left: 24px;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 2.2;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.spec > div {
		display: flex;
		justify-content: space-between;
		border-bottom: 1px solid var(--line-soft);
	}
	.spec > div:last-child {
		border-bottom: 0;
	}
	.spec dt {
		color: var(--muted);
	}
	.spec dd {
		margin: 0;
		color: var(--fg);
	}
	.hero-portrait {
		grid-column: 9 / span 4;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line-soft);
		min-height: 240px;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		background: var(--panel);
	}
	.hero-portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
	}

	/* ---- rail body shared ---- */
	.rail-body {
		padding: 52px 0;
	}

	/* ---- 01 path ---- */
	.path-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--line);
	}
	.path-cell {
		padding: 22px 24px;
		border-right: 1px solid var(--line-soft);
	}
	.path-cell:first-child {
		padding-left: 0;
	}
	.path-cell.now {
		background: var(--accent-soft);
		border-right: 0;
	}
	.path-kicker {
		margin-bottom: 14px;
	}
	.path-kicker.accent {
		color: var(--accent);
	}
	.path-title {
		font-size: 22px;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}
	.path-desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: var(--body);
	}

	/* ---- 02 method ---- */
	.method-body {
		border-top: 1px solid var(--line);
	}
	.method-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(24px, 5vw, 56px);
	}
	.method-h2 {
		margin: 0 0 18px;
		font-size: clamp(26px, 3vw, 34px);
		font-weight: 500;
		letter-spacing: -0.03em;
	}
	.method-p {
		margin: 0 0 26px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--body);
		max-width: 46ch;
		text-wrap: pretty;
	}
	.method-grid > div:first-child .method-p {
		margin-bottom: 0;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	/* ---- 04 contact ---- */
	.contact-body {
		padding: clamp(56px, 8vw, 96px) 0 52px;
	}
	.contact-h2 {
		margin: 0 0 24px;
		font-size: clamp(40px, 6vw, 84px);
		line-height: 0.94;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.contact-p {
		margin: 0 0 34px;
		font-size: 17px;
		line-height: 1.6;
		max-width: 40ch;
		color: var(--body);
	}
	.contact-actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	/* ---- responsive ---- */
	@media (max-width: 900px) {
		.hero-grid > * {
			grid-column: 1 / span 12;
			border-left: 0;
		}
		.hero-lede {
			padding-right: 0;
		}
		.hero-spec {
			padding-right: 0;
		}
		.path-grid {
			grid-template-columns: 1fr 1fr;
		}
		.path-cell:nth-child(2n) {
			border-right: 0;
		}
		.method-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
